APP_NAME=MYDS-Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=laravel-session

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000,::1

# SRS-RBC-01: set to false to make SSO MAIS the only way to sign in
AUTH_PASSWORD_LOGIN=true

# SRS-RBC-01 / SRS-RBC-03: SSO MAIS OIDC IdP (local Keycloak: infra/bin/keycloak-dev.sh)
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=mais
KEYCLOAK_CLIENT_ID=sisdata-web
KEYCLOAK_CLIENT_SECRET=sisdata-web-dev-secret
KEYCLOAK_REDIRECT_URI="${FRONTEND_URL}/auth/oidc/callback"
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="${FRONTEND_URL}/login"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DOKUMEN_S3_ENDPOINT=http://127.0.0.1:9000
DOKUMEN_S3_KEY=sisdata
DOKUMEN_S3_SECRET=sisdata_minio_pw
DOKUMEN_S3_BUCKET=sisdata-dokumen

CLAMAV_SOCKET=/opt/homebrew/var/run/clamav/clamd.sock
GEOSERVER_URL=http://127.0.0.1:8085/geoserver
