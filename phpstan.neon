includes:
    - vendor/larastan/larastan/extension.neon
    # Baseline holds only pre-existing template-code findings. Do not grow it:
    # fix new findings instead, and remove entries as the code they cover is fixed.
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/
    tmpDir: storage/framework/cache/phpstan
